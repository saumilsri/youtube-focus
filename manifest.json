{
  "manifest_version": 3,
  "name": "YouTube Focus",
  "version": "1.0.0",
  "description": "Replaces the YouTube home feed with 3 locked picks, hides Shorts, trims the watch sidebar to 5 videos and turns off autoplay.",
  "minimum_chrome_version": "111",
  "permissions": [
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "main.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://youtube.com/*"
      ],
      "js": [
        "shared.js",
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_start"
    }
  ]
}
